# PotholeIQ API — copy to .env and fill in values before deploying

# Comma-separated list of allowed frontend origins
# Dev default: * (all origins)
# Production example: http://localhost:5173,https://potholeiq.yourdomain.com
CORS_ORIGINS=*

# Secret for POST /admin/refresh
ADMIN_SECRET=potholeiq-dev

# API key for POST /alerts/send  (X-Api-Key header)
ADMIN_API_KEY=change-me-in-production
