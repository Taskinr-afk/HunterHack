# PotholeIQ API — copy to .env and fill in values before deploying

# Frontend origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173

# Environment: development | production
ENVIRONMENT=development

# Admin secret for POST /admin/refresh
ADMIN_SECRET=potholeiq-dev

# API key for /alerts/send and /alerts/scan  (X-Api-Key header)
ADMIN_API_KEY=change-me-in-production

# ── SMTP alert email ──────────────────────────────────────────────────────────
# Leave blank to disable email (alerts will be logged to console instead)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=dot.notifications@nyc.gov

# Minimum risk score (0–100) to trigger auto-scan alerts
ALERT_RISK_THRESHOLD=75.0
