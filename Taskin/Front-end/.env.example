# Copy this file to .env and fill in your real values
# NEVER commit your real .env file!

# Backend API URL (required — no hardcoded fallback in production)
VITE_API_BASE_URL=http://localhost:8000

# Map tile URL (optional — defaults to CARTO dark basemap)
# Switch to Mapbox or other provider by setting this and VITE_MAPBOX_TOKEN
VITE_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png

# Mapbox public token (only needed if switching tile provider to Mapbox)
# VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here