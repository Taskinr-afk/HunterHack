# Copy this file to .env and fill in your real values
# NEVER commit your real .env file!

# ── Mailtrap (demo/testing) ──────────────────────────────────
# Sign up free at https://mailtrap.io → Email Testing → Sandboxes
# Copy the sandbox SMTP credentials below
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_mailtrap_username
SMTP_PASS=your_mailtrap_password
ALERT_EMAIL_TO=your_mailtrap_inbox@inbox.mailtrap.io

# ── Production (real email delivery) ─────────────────────────
# Switch to Mailtrap sending, Brevo, Resend, or Gmail:
# SMTP_HOST=live.smtp.mailtrap.io   (or smtp.gmail.com, smtp-relay.brevo.com)
# SMTP_PORT=587
# SMTP_USER=api                     (for Mailtrap) or your email
# SMTP_PASS=your_api_token          (for Mailtrap) or app password

MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here
NYC_OPENDATA_APP_TOKEN=your_app_token_here
DATABASE_URL=sqlite:///./potholes.db
SECRET_KEY=change-this-to-a-random-string-at-least-32-chars
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
ADMIN_API_KEY=change-this-to-a-random-secret-key
ADMIN_SECRET=potholeiq-dev
ENVIRONMENT=development
ALERT_RISK_THRESHOLD=75.0